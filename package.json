{
  "name": "parley",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "pnpm --filter @parley/platform build",
    "build:kit": "pnpm --filter @parley/kit build",
    "dev": "pnpm --filter @parley/platform dev",
    "e2e": "playwright test --pass-with-no-tests",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  }
}
