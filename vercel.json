{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @parley/platform build",
  "devCommand": "pnpm --filter @parley/platform dev",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "apps/platform/.next",
  "crons": [
    { "path": "/api/cron/expire", "schedule": "*/5 * * * *" },
    { "path": "/api/v1/demo-reset", "schedule": "0 * * * *" }
  ]
}
